# Copy to .env.local for local development. On Vercel, add these under
# Project Settings > Environment Variables instead.

# Required. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Recommended once deployed. Anyone with your URL could otherwise spend your
# API credits. When set, the app asks for this password once per device.
APP_PASSWORD=

# Optional model overrides.
# KNOWING_CHAT_MODEL=claude-opus-5-5
# KNOWING_EXTRACT_MODEL=claude-haiku-5-5

# Optional. Lets Knowing hear speech in uploaded videos.
# https://platform.openai.com/api-keys (or a Groq key with KNOWING_TRANSCRIBE_URL below)
OPENAI_API_KEY=
# KNOWING_TRANSCRIBE_URL=https://api.groq.com/openai/v1/audio/transcriptions
# KNOWING_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# KNOWING_VIDEO_MODEL=claude-sonnet-5-5

# Telegram bot (optional). Setup: docs/TELEGRAM.md
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_USERS=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# KNOWING_BOT_MODEL=claude-haiku-5-5
# KNOWING_TIKTOK_RESOLVER=https://www.tikwm.com/api/
